<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.Emotions">

    <TextView
        android:id="@+id/textViewEmotionsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How are you feeling right now?"
        android:textSize="22sp"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Using a Flow layout for easy arrangement, requires ConstraintLayout 2.0.0+ -->
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flowEmotions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        app:constraint_referenced_ids="buttonHappy, buttonCalm, buttonSad, buttonAngry"
        app:flow_wrapMode="chain"
        app:flow_maxElementsWrap="2"
        app:flow_horizontalGap="16dp"
        app:flow_verticalGap="16dp"
        app:layout_constraintTop_toBottomOf="@id/textViewEmotionsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/buttonHappy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Happy"
        android:minHeight="80dp"
        tools:layout_editor_absoluteX="50dp"
        tools:layout_editor_absoluteY="150dp" />

    <Button
        android:id="@+id/buttonCalm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Calm"
        android:minHeight="80dp"
        tools:layout_editor_absoluteX="200dp"
        tools:layout_editor_absoluteY="150dp" />

    <Button
        android:id="@+id/buttonSad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sad"
        android:minHeight="80dp"
        tools:layout_editor_absoluteX="50dp"
        tools:layout_editor_absoluteY="250dp" />

    <Button
        android:id="@+id/buttonAngry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Angry"
        android:minHeight="80dp"
        tools:layout_editor_absoluteX="200dp"
        tools:layout_editor_absoluteY="250dp" />


</androidx.constraintlayout.widget.ConstraintLayout>