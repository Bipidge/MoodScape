<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">>

    <!-- Timestamp on the side -->
    <TextView
        android:id="@+id/textViewTimestampSide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        tools:text="16:00\n25/11/2024"
        android:gravity="center_horizontal"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cardViewEntry"
        app:layout_constraintBottom_toBottomOf="@+id/cardViewEntry" />

    <!-- Vertical line (approximated with a simple View) -->
    <View
        android:id="@+id/viewTimeline"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="?android:attr/textColorSecondary"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textViewTimestampSide"
        />

    <!-- Card for the main entry content -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardViewEntry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/viewTimeline"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/linearLayoutCardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Emotion (used for background, could be hidden or styled differently) -->
            <TextView
                android:id="@+id/textViewEmotion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                tools:text="Happy" /> <!-- Use emotion as title? -->

            <!-- Entry Text -->
            <TextView
                android:id="@+id/textViewEntryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                android:textColor="@android:color/white"
                tools:text="Body X Body X Body X Body X Body X Body X Body X Body X Body X Body X Body X Body X Body X Body X Body X Body X Body X Body X" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>